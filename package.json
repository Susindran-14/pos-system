{
  "name": "tamil-dress-collection-pos",
  "version": "4.0.0",
  "description": "Tamil Dress Collection Retail & Textile POS System",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run backend\" \"npm run frontend\"",
    "start": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run backend\" \"npm run frontend\"",
    "frontend": "npm --prefix frontend run dev",
    "backend": "cd backend && .\\venv\\Scripts\\python run.py",
    "sync:neon": "cd backend && .\\venv\\Scripts\\python migrate_to_neon.py",
    "build": "npm --prefix frontend run build"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
